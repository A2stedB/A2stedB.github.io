---
import Project_card from "../component/project_card_template.astro";
import Project_modal from "../component/project_modal_template.astro";
import Test_Project from "../project-page/test-project.astro";
import About from "../component/about.md";
import Focus from "../component/focus.md";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="icon/border.svg" />

		<!-- <meta name="viewport" content="width=device-width initial-scale=1" /> -->
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<link rel="stylesheet" href="style/style.css" />
		<link rel="stylesheet" href="style/font-settings.css" />
		<link rel="stylesheet" href="style/colour-palette.css" />
		<script src="../script/main.js"></script>
		<script src="../script/scramble_text.js"></script>

		<title>My website</title>
	</head>

	<body>
		<div id="background-base-colour" class="light" data-element="background">
		</div>
		<div></div>
		<div></div>
		<div id="background-square-grid" class="light" data-element="background">
		</div>
		<div id="dark-filter"></div>
		<!-- <div class="vertical-edge-text" data-element="background">
			SYS.OVERRIDE // PORTFOLIO_V1.0
		</div> -->

		<main id="main">
			<section id="presentation" class="slide non-selectable">
				<div id="presentation-top-decoration">
					<div class="presentation-top-decoration-container first">
						SYS.BOOT // V1.0 // PROFILE
					</div>
				</div>

				<div id="presentation-grid">
					<div id="presentation-name" class="presentation-box">
						<div>He</div>
					</div>

					<div id="presentation-surname" class="presentation-box">
						<div>Deng</div>
					</div>

					<div id="presentation-introduction" class="presentation-box">
						<div>[ Software / Game Developer ]</div>
					</div>
				</div>
			</section>
			<!--presentation -->

			<section id="about" class="slide">
				<div id="about-title" class="non-selectable">
					<div class="align-bottom">ABOUT</div>
				</div>

				<div id="about-content-container">
					<div id="about-container">
						<!-- bio -->

						<div id="about-content-biography" class="about-content-container">
							<div class="about-content-title">[ BIO ]</div>
							<div class="about-content-content">
								<About />
							</div>
						</div>

						<!-- focus -->
						<div id="about-content-focus">
							<div class="about-content-title">[ FOCUS ]</div>
							<div class="about-content-content">
								<Focus />
							</div>
						</div>

						<div id="about-content-extra">
							<div class="about-content-title">[ EXTRA ]</div>
							<div class="about-content-content">
								<Focus />
							</div>
						</div>
					</div>

					<div id="about-bottom-decoration-grid">
						<div class="bordered-box"></div>
						<div class="bordered-box"></div>
						<div class="bordered-box"></div>
						<div class="bordered-box"></div>
					</div>
				</div>
			</section>

			<section id="project" class="slide non-selectable">
				<div id="project-container" class="slide-container"></div>
			</section>

			<section id="skills" class="slide non-selectable">
				<div class="slide-container">a</div>
			</section>
		</main>

		<div class="modal-container">
			<Project_modal project_name="Kingless Dungeon">
				<Test_Project />
			</Project_modal>
		</div>
	</body>
</html>
